#include <stdio.h>

int main() {
    char *nama[5] = {"Air Mineral", "Teh Botol", "Roti", "Keripik", "Kopi"};
    int harga[5] = {15000, 18000, 20000, 22000, 25000};
    int dipilih[3];
    int jumlah = 0, total = 0, pilih, i;

    while (jumlah < 3 && total < 50000) {
        printf("\n=== DAFTAR PRODUK ===\n");
        for (i = 0; i < 5; i++) {
            printf("d. %s - Rp%d\n", i + 1, nama[i], harga[i]);
        }
        printf("6. Selesai\n);
        printf("Pilih: ");
        scanf("%d", &pilih);

        if (pilih == 6) {
            break;
        } else if (pilih >= 1 && pilih <= 5) {
            dipilih[jumlah] = pilih - 1;
            total += harga[pilih - 1];
            jumlah++;
        } else {
            printf("Pilihan tidak valid\n");
        }
    }

    printf("\n=== PRODUK YANG DIPILIH ===\n");
    for (i = 0; i < jumlah; i+) {
        printf("%d. %s - Rp%d\n", i + 1, nama[dipilih[i]], harga[dipilih[i]]);
    }
    printf("Total tagihan: Rp%d\n", total);
    return 0;
}